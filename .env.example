# ---------------------------------------------------------------------------
# Type Arena — environment variables
# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle. Only put
# public identifiers there (e.g. an AdSense publisher ID). Never put secrets,
# database URLs or service-role keys in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# PostgreSQL connection string (Neon, Vercel Postgres, local Postgres, ...)
#
# Local development:
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"
#
# Neon (copy from the Neon console → Connect → "Pooled connection"):
#   DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"
#
# Keep this in .env.local (git-ignored) or in Vercel → Settings → Environment Variables.
# Never commit a real connection string.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# --- Optional: operator account + demo data -------------------------------
ADMIN_USERNAME="type_arena"
ADMIN_PASSWORD=""
ADMIN_EMAIL="admin@typearena.gg"
SEED_DEMO="0"

# --- Canonical site URL (SEO, sitemap, robots, canonical tags) ------------
# Production: https://type-arena-silk.vercel.app (or a custom domain once attached)
NEXT_PUBLIC_SITE_URL="https://type-arena-silk.vercel.app"

# --- Google AdSense (all values are PUBLIC identifiers) -------------------
# 1. Publisher ID: AdSense → Account → Settings → Account information → Publisher ID
#    Format: ca-pub-<16 digits>
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-REPLACE_WITH_MY_PUBLISHER_ID"

# 2. Ad unit slot IDs: AdSense → Ads → By ad unit → create a "Display" unit,
#    then copy the numeric data-ad-slot value.
NEXT_PUBLIC_ADSENSE_SLOT_HOME="REPLACE_WITH_HOME_AD_SLOT_ID"
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT="REPLACE_WITH_CONTENT_AD_SLOT_ID"
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS="REPLACE_WITH_RESULTS_AD_SLOT_ID"

# 3. Master switch. Set to "true" ONLY in Vercel's Production environment,
#    after the site is approved and the real IDs above are in place.
#    Leaving it unset/false keeps every ad unit dormant (no requests, no traffic).
NEXT_PUBLIC_ADSENSE_ENABLED="false"

# 4. Optional: force the inert development placeholder in a production build
#    (e.g. a preview deployment). NEVER enable this on the public site.
NEXT_PUBLIC_ADSENSE_TEST_MODE="false"

# 5. Optional: replace the generated /ads.txt body with Google's exact seller
#    declaration from AdSense → Ads → By site → ads.txt. Server-only.
#    Example: google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
ADSENSE_ADS_TXT=""

# --- Optional: Google Analytics 4 ----------------------------------------
# Leave empty to ship no analytics at all. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
